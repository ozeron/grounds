            Equal.trans(J.St,
              J.loop(A.add(A.add(A.add(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n), A.len(SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))})), J.Run{SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}, Con{J.FObj{acc, k}, up}, J.MColon{}}),
              J.loop(A.add(A.add(A.add(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n), A.len(S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)))), J.Run{S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)), Con{J.FObj{acc, k}, up}, J.MValue{}}),
              J.loop(A.add(w2, A.len(r)), J.emit(J.JObj{PA.rlf(acc, Con{J.Field{k, v}, t})}, r, up)),
              PA.step(A.add(A.add(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n), SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}, A.len(S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))), Con{J.FObj{acc, k}, up}, J.MColon{}, {==}),
              Equal.trans(J.St,
                J.loop(A.add(A.add(A.add(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n), A.len(S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)))), J.Run{S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)), Con{J.FObj{acc, k}, up}, J.MValue{}}),
                J.loop(A.add(w1, A.len(S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))), J.Run{S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r), Con{J.FObj{Con{J.Field{k, v}, acc}, ""}, up}, J.MCommaOrClose{}}),
                J.loop(A.add(w2, A.len(r)), J.emit(J.JObj{PA.rlf(acc, Con{J.Field{k, v}, t})}, r, up)),
                p1,
                p2))))))))

law obj_t.3:
  for +k: String
  for +v: J.Json
  for +t: List<&2, J.Field>
  for +acc: List<&2, J.Field>
  for +k0: String
  for +up: List<&2, J.Frame>
  for +r: String
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +x: Nat
  for ex: {A.len(S.esc(k, SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}})) == A.add(x, A.len(SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}})) : Nat}
  for +w1: Nat
  for p1: {J.loop(A.add(A.add(A.add(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n), A.len(S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)))), J.Run{S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)), Con{J.FObj{acc, k}, up}, J.MValue{}}) == J.loop(A.add(w1, A.len(S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))), PA.result(False{}, v, Con{J.FObj{acc, k}, up}, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))) : J.St}
  for g2: Goal("", J.JObj{t}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{Con{J.Field{k, v}, acc}, ""}, up}, r, w1)
  Goal("", J.JObj{Con{J.Field{k, v}, t}}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{acc, k0}, up}, r, slack)

def obj_t.3(k, v, t, acc, k0, up, r, slack, p, cs, d, x, ex, w1, p1, g2):
  (+w2, p2) = g2
  obj_t.4(k, v, t, acc, k0, up, r, slack, p, cs, d, x, ex, w1, p1, w2, p2)

law obj_t.2:
  for +k: String
  for +v: J.Json
  for +t: List<&2, J.Field>
  for +acc: List<&2, J.Field>
  for +k0: String
  for +up: List<&2, J.Frame>
  for +r: String
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +x: Nat
  for ex: {A.len(S.esc(k, SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}})) == A.add(x, A.len(SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}})) : Nat}
  for g1: Goal(S.sp(p), v, False{}, p, cs, 1n+d, J.MValue{}, Con{J.FObj{acc, k}, up}, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r), A.add(A.add(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n))
  for ih2: @w: Nat -> Goal("", J.JObj{t}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{Con{J.Field{k, v}, acc}, ""}, up}, r, w)
  Goal("", J.JObj{Con{J.Field{k, v}, t}}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{acc, k0}, up}, r, slack)

def obj_t.2(k, v, t, acc, k0, up, r, slack, p, cs, d, x, ex, g1, ih2):
  (+w1, p1) = g1
  obj_t.3(k, v, t, acc, k0, up, r, slack, p, cs, d, x, ex, w1, p1, ih2(w1))

law obj_t.1:
  for +k: String
  for +v: J.Json
  for +t: List<&2, J.Field>
  for +acc: List<&2, J.Field>
  for +k0: String
  for +up: List<&2, J.Frame>
  for +r: String
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for pk: A.Pre(S.esc(k, SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}}), SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}})
  for ih1: @s: Nat -> Goal(S.sp(p), v, False{}, p, cs, 1n+d, J.MValue{}, Con{J.FObj{acc, k}, up}, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r), s)
  for ih2: @w: Nat -> Goal("", J.JObj{t}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{Con{J.Field{k, v}, acc}, ""}, up}, r, w)
  Goal("", J.JObj{Con{J.Field{k, v}, t}}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{acc, k0}, up}, r, slack)

def obj_t.1(k, v, t, acc, k0, up, r, slack, p, cs, d, pk, ih1, ih2):
  (+x, ex) = pk
  obj_t.2(k, v, t, acc, k0, up, r, slack, p, cs, d, x, ex, ih1(A.add(A.add(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n)), ih2)

# the main lemma: from any point where the text of j starts, maybe behind
# white space, the loop reads it and lands on result(...), with fuel to spare
law run:
  for +j: J.Json
  for +more: Bool
  for +pre: String
  for wp: Ws(pre)
  for np: NoPre(more, pre)
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +m: J.Mode
  for +stk: List<&2, J.Frame>
  for +r: String
  for +slack: Nat
  for ctx: PA.Ctx(more, j, m, stk)
  for dl: Num.Delim(r)
  Goal(pre, j, more, p, cs, d, m, stk, r, slack)

def run(j, more, pre, wp, np, p, cs, d, m, stk, r, slack, ctx, dl):
  match j:
    case J.JNull{}:
      match more:
        case False{}:
          g_null(pre, wp, slack, p, cs, d, m, ctx, stk, r)
        case True{}:
          match ctx:
    case J.JBool{True{}}:
      match more:
        case False{}:
          g_true(pre, wp, slack, p, cs, d, m, ctx, stk, r)
        case True{}:
          match ctx:
    case J.JBool{False{}}:
      match more:
        case False{}:
          g_false(pre, wp, slack, p, cs, d, m, ctx, stk, r)
        case True{}:
          match ctx:
    case J.JNum{n}:
      match more:
        case False{}:
          g_num(n, pre, wp, slack, p, cs, d, m, ctx, stk, r, dl)
        case True{}:
          match ctx:
    case J.JStr{s}:
      match more:
        case False{}:
          g_str(s, pre, wp, slack, p, cs, d, m, ctx, stk, r)
        case True{}:
          match ctx:
    case J.JArr{Nil{}}:
      match more:
        case False{}:
          g_arr_nil(pre, wp, slack, p, cs, d, m, ctx, stk, r)
        case True{}:
          match m:
            case J.MCommaOrClose{}:
              match stk:
                case Con{J.FArr{acc}, up}:
                  %Equal.sym(String, pre, "", np) : Goal(_, J.JArr{[]}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{acc}, up}, r, slack)
                  g_arr_nil_t(acc, up, r, slack, p, cs, d)
                case Con{J.FObj{_, _}, _}:
                  match ctx:
                case Nil{}:
                  match ctx:
            case J.MValue{}:
              match ctx:
            case J.MValueOrClose{}:
              match ctx:
            case J.MKeyOrClose{}:
              match ctx:
            case J.MKey{}:
              match ctx:
            case J.MColon{}:
              match ctx:
    case J.JArr{Con{h, t}}:
      match more:
        case False{}:
          arr_f.1(h, t, stk, r, pre, wp, slack, m, ctx, p, cs, d,
            run(h, False{}, S.bw(p, S.wstr(cs), 1n+d), w => bw_ws(p, cs, 1n+d, w), Unit{}, p, cs, 1n+d, J.MValueOrClose{}, Con{J.FArr{[]}, stk}, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r), A.add(slack, A.len(pre)), Unit{}, delim_arr(t, r, p, cs, d)),
            w => run(J.JArr{t}, True{}, "", s => {==}, {==}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{[h]}, stk}, r, w, Unit{}, dl))
        case True{}:
          match m:
            case J.MCommaOrClose{}:
              match stk:
                case Con{J.FArr{acc}, up}:
                  %Equal.sym(String, pre, "", np) : Goal(_, J.JArr{Con{h, t}}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{acc}, up}, r, slack)
                  arr_t.1(h, t, acc, up, r, slack, p, cs, d, run(h, False{}, S.bw(p, S.wstr(cs), 1n+d), w => bw_ws(p, cs, 1n+d, w), Unit{}, p, cs, 1n+d, J.MValue{}, Con{J.FArr{acc}, up}, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r), slack, Unit{}, delim_arr(t, r, p, cs, d)), w => run(J.JArr{t}, True{}, "", s => {==}, {==}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{Con{h, acc}}, up}, r, w, Unit{}, dl))
                case Con{J.FObj{_, _}, _}:
                  match ctx:
                case Nil{}:
                  match ctx:
            case J.MValue{}:
              match ctx:
            case J.MValueOrClose{}:
              match ctx:
            case J.MKeyOrClose{}:
              match ctx:
            case J.MKey{}:
              match ctx:
            case J.MColon{}:
              match ctx:
    case J.JObj{Nil{}}:
      match more:
        case False{}:
          g_obj_nil(pre, wp, slack, p, cs, d, m, ctx, stk, r)
        case True{}:
          match m:
            case J.MCommaOrClose{}:
              match stk:
                case Con{J.FObj{acc, k0}, up}:
                  %Equal.sym(String, pre, "", np) : Goal(_, J.JObj{[]}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{acc, k0}, up}, r, slack)
                  g_obj_nil_t(acc, k0, up, r, slack, p, cs, d)
                case Con{J.FArr{_}, _}:
                  match ctx:
                case Nil{}:
                  match ctx:
            case J.MValue{}:
              match ctx:
            case J.MValueOrClose{}:
              match ctx:
            case J.MKeyOrClose{}:
              match ctx:
            case J.MKey{}:
              match ctx:
            case J.MColon{}:
              match ctx:
    case J.JObj{Con{J.Field{k, v}, t}}:
      match more:
        case False{}:
          obj_f.1(k, v, t, stk, r, pre, wp, slack, m, ctx, p, cs, d, A.pre_esc(k, SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}}),
            s => run(v, False{}, S.sp(p), w => sp_ws(p, w), Unit{}, p, cs, 1n+d, J.MValue{}, Con{J.FObj{[], k}, stk}, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r), s, Unit{}, delim_obj(t, r, p, cs, d)),
            w => run(J.JObj{t}, True{}, "", s => {==}, {==}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{[J.Field{k, v}], ""}, stk}, r, w, Unit{}, dl))
        case True{}:
          match m:
            case J.MCommaOrClose{}:
              match stk:
                case Con{J.FObj{acc, k0}, up}:
                  %Equal.sym(String, pre, "", np) : Goal(_, J.JObj{Con{J.Field{k, v}, t}}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{acc, k0}, up}, r, slack)
                  obj_t.1(k, v, t, acc, k0, up, r, slack, p, cs, d, A.pre_esc(k, SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}}), s => run(v, False{}, S.sp(p), w => sp_ws(p, w), Unit{}, p, cs, 1n+d, J.MValue{}, Con{J.FObj{acc, k}, up}, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r), s, Unit{}, delim_obj(t, r, p, cs, d)), w => run(J.JObj{t}, True{}, "", s => {==}, {==}, p, cs, d, J.MCommaOrClose{}, Con{J.FObj{Con{J.Field{k, v}, acc}, ""}, up}, r, w, Unit{}, dl))
                case Con{J.FArr{_}, _}:
                  match ctx:
                case Nil{}:
                  match ctx:
            case J.MValue{}:
              match ctx:
            case J.MValueOrClose{}:
              match ctx:
            case J.MKeyOrClose{}:
              match ctx:
            case J.MKey{}:
              match ctx:
            case J.MColon{}:
              match ctx:

# no laid-out value starts with a byte order mark
law bom:
  for +j: J.Json
  for +p: Bool
  for +u: String
  {J.skip_bom(S.lay(j, False{}, p, u, 0n, "")) == S.lay(j, False{}, p, u, 0n, "") : String}

def bom(j, p, u):
  match j:
    case J.JNull{}:
      {==}
    case J.JBool{True{}}:
      {==}
    case J.JBool{False{}}:
      {==}
    case J.JStr{_}:
      {==}
    case J.JArr{Nil{}}:
      {==}
    case J.JArr{Con{_, _}}:
      {==}
    case J.JObj{Nil{}}:
      {==}
    case J.JObj{Con{J.Field{_, _}, _}}:
      {==}
    case J.JNum{J.Number{True{}, _, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.IZero{}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L1{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L2{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L3{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L4{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L5{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L6{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L7{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L8{}, _}, _, _}}:
      {==}
    case J.JNum{J.Number{False{}, J.INon{J.L9{}, _}, _, _}}:
      {==}

law parse.go:
  for +j: J.Json
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for g: Goal("", j, False{}, p, cs, 0n, J.MValue{}, [], "", 1n)
  {J.finish(J.lines(S.lay(j, False{}, p, S.wstr(cs), 0n, ""), 0, []), J.loop(1n+A.len(S.lay(j, False{}, p, S.wstr(cs), 0n, "")), J.Run{S.lay(j, False{}, p, S.wstr(cs), 0n, ""), [], J.MValue{}})) == Done{j} : PA.RJ()}

def parse.go(j, p, cs, g):
  (+w, e) = g
  +t : String = S.lay(j, False{}, p, S.wstr(cs), 0n, "")
  Equal.cong(J.St, PA.RJ(), x => J.finish(J.lines(t, 0, []), x),
    J.loop(1n+A.len(t), J.Run{t, [], J.MValue{}}), J.Fin{j},
    Equal.trans(J.St, J.loop(1n+A.len(t), J.Run{t, [], J.MValue{}}), J.loop(A.add(w, 0n), J.Fin{j}), J.Fin{j},
      e,
      PA.loop_fin(A.add(w, 0n), j)))

# the parser reads back what the pretty printer writes, for any indent unit
# made of spaces and tabs
law parse_pretty:
  for +j: J.Json
  for +cs: List<&2, S.WsC>
  {J.parse(J.pretty(j, S.wstr(cs))) == Done{j} : PA.RJ()}

def parse_pretty(j, cs):
  +t : String = S.lay(j, False{}, True{}, S.wstr(cs), 0n, "")
  %Equal.sym(String, J.pretty(j, S.wstr(cs)), t, P.pretty(j, S.wstr(cs))) : {J.parse(_) == Done{j} : PA.RJ()}
  %Equal.sym(String, J.skip_bom(t), t, bom(j, True{}, S.wstr(cs))) : {J.finish(J.lines(t, 0, []), J.loop(1n+A.len(t), J.Run{_, [], J.MValue{}})) == Done{j} : PA.RJ()}
  parse.go(j, True{}, cs, run(j, False{}, "", s => {==}, Unit{}, True{}, cs, 0n, J.MValue{}, [], "", 1n, Unit{}, Unit{}))

# what grounds-json writes
law pretty_round_trip:
  for +j: J.Json
  {J.parse(J.pretty(j, "  ")) == Done{j} : PA.RJ()}

def pretty_round_trip(j):
  parse_pretty(j, [S.WSpace{}, S.WSpace{}])
