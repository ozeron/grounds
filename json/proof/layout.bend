law g_str.x:
  for +s: String
  for +pre: String
  for wp: Ws(pre)
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +m: J.Mode
  for vm: PA.ValMode(m)
  for +stk: List<&2, J.Frame>
  for +r: String
  for +x: Nat
  for ex: {A.len(S.esc(s, SCon{'"', r})) == A.add(x, A.len(SCon{'"', r})) : Nat}
  Goal(pre, J.JStr{s}, False{}, p, cs, d, m, stk, r, slack)

def g_str.x(s, pre, wp, slack, p, cs, d, m, vm, stk, r, x, ex):
  match m:
    case J.MValue{}:
      (A.add(A.add(A.add(slack, A.len(pre)), x), 1n), Equal.trans(J.St,
          J.loop(A.add(slack, A.len(pre ++ S.str(s, r))), J.Run{pre ++ S.str(s, r), stk, J.MValue{}}),
          J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.token(~J.mk_str, J.lex_str(S.esc(s, SCon{'"', r}), J.SGo{"", 0}), stk)),
          J.loop(A.add(A.add(A.add(A.add(slack, A.len(pre)), x), 1n), A.len(r)), J.emit(J.JStr{s}, r, stk)),
          adv(slack, pre, S.str(s, r), A.len(S.esc(s, SCon{'"', r})), stk, J.MValue{}, {==}, wp(S.str(s, r))),
          Equal.trans(J.St,
            J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.token(~J.mk_str, J.lex_str(S.esc(s, SCon{'"', r}), J.SGo{"", 0}), stk)),
            J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.emit(J.JStr{s}, r, stk)),
            J.loop(A.add(A.add(A.add(A.add(slack, A.len(pre)), x), 1n), A.len(r)), J.emit(J.JStr{s}, r, stk)),
            Equal.cong(J.Lex, J.St, y => J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.token(~J.mk_str, y, stk)), J.lex_str(S.esc(s, SCon{'"', r}), J.SGo{"", 0}), J.LOk{s, r}, Str.body(s, "", r)),
            Equal.trans(J.St,
              J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.emit(J.JStr{s}, r, stk)),
              J.loop(A.add(A.add(slack, A.len(pre)), A.add(x, A.add(1n, A.len(r)))), J.emit(J.JStr{s}, r, stk)),
              J.loop(A.add(A.add(A.add(A.add(slack, A.len(pre)), x), 1n), A.len(r)), J.emit(J.JStr{s}, r, stk)),
              Equal.cong(Nat, J.St, f => J.loop(A.add(A.add(slack, A.len(pre)), f), J.emit(J.JStr{s}, r, stk)), A.len(S.esc(s, SCon{'"', r})), A.add(x, A.add(1n, A.len(r))), ex),
              PA.regroup2(A.add(slack, A.len(pre)), x, 1n, A.len(r), J.emit(J.JStr{s}, r, stk))))))
    case J.MValueOrClose{}:
      (A.add(A.add(A.add(slack, A.len(pre)), x), 1n), Equal.trans(J.St,
          J.loop(A.add(slack, A.len(pre ++ S.str(s, r))), J.Run{pre ++ S.str(s, r), stk, J.MValueOrClose{}}),
          J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.token(~J.mk_str, J.lex_str(S.esc(s, SCon{'"', r}), J.SGo{"", 0}), stk)),
          J.loop(A.add(A.add(A.add(A.add(slack, A.len(pre)), x), 1n), A.len(r)), J.emit(J.JStr{s}, r, stk)),
          adv(slack, pre, S.str(s, r), A.len(S.esc(s, SCon{'"', r})), stk, J.MValueOrClose{}, {==}, wp(S.str(s, r))),
          Equal.trans(J.St,
            J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.token(~J.mk_str, J.lex_str(S.esc(s, SCon{'"', r}), J.SGo{"", 0}), stk)),
            J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.emit(J.JStr{s}, r, stk)),
            J.loop(A.add(A.add(A.add(A.add(slack, A.len(pre)), x), 1n), A.len(r)), J.emit(J.JStr{s}, r, stk)),
            Equal.cong(J.Lex, J.St, y => J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.token(~J.mk_str, y, stk)), J.lex_str(S.esc(s, SCon{'"', r}), J.SGo{"", 0}), J.LOk{s, r}, Str.body(s, "", r)),
            Equal.trans(J.St,
              J.loop(A.add(A.add(slack, A.len(pre)), A.len(S.esc(s, SCon{'"', r}))), J.emit(J.JStr{s}, r, stk)),
              J.loop(A.add(A.add(slack, A.len(pre)), A.add(x, A.add(1n, A.len(r)))), J.emit(J.JStr{s}, r, stk)),
              J.loop(A.add(A.add(A.add(A.add(slack, A.len(pre)), x), 1n), A.len(r)), J.emit(J.JStr{s}, r, stk)),
              Equal.cong(Nat, J.St, f => J.loop(A.add(A.add(slack, A.len(pre)), f), J.emit(J.JStr{s}, r, stk)), A.len(S.esc(s, SCon{'"', r})), A.add(x, A.add(1n, A.len(r))), ex),
              PA.regroup2(A.add(slack, A.len(pre)), x, 1n, A.len(r), J.emit(J.JStr{s}, r, stk))))))
    case J.MKeyOrClose{}:
      match vm:
    case J.MKey{}:
      match vm:
    case J.MColon{}:
      match vm:
    case J.MCommaOrClose{}:
      match vm:

law g_str.w:
  for +s: String
  for +pre: String
  for wp: Ws(pre)
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +m: J.Mode
  for vm: PA.ValMode(m)
  for +stk: List<&2, J.Frame>
  for +r: String
  for w: A.Pre(S.esc(s, SCon{'"', r}), SCon{'"', r})
  Goal(pre, J.JStr{s}, False{}, p, cs, d, m, stk, r, slack)

def g_str.w(s, pre, wp, slack, p, cs, d, m, vm, stk, r, w):
  (+x, ex) = w
  g_str.x(s, pre, wp, slack, p, cs, d, m, vm, stk, r, x, ex)

law g_str:
  for +s: String
  for +pre: String
  for wp: Ws(pre)
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +m: J.Mode
  for vm: PA.ValMode(m)
  for +stk: List<&2, J.Frame>
  for +r: String
  Goal(pre, J.JStr{s}, False{}, p, cs, d, m, stk, r, slack)

def g_str(s, pre, wp, slack, p, cs, d, m, vm, stk, r):
  g_str.w(s, pre, wp, slack, p, cs, d, m, vm, stk, r, A.pre_esc(s, SCon{'"', r}))

law g_num.w:
  for +n: J.Number
  for +pre: String
  for wp: Ws(pre)
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +m: J.Mode
  for vm: PA.ValMode(m)
  for +stk: List<&2, J.Frame>
  for +r: String
  for dl: Num.Delim(r)
  for w: A.Pre1(J.num_k(n, r), r)
  Goal(pre, J.JNum{n}, False{}, p, cs, d, m, stk, r, slack)

