    J.loop(A.add(slack, A.len(SCon{',', S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r))})), J.Run{SCon{',', S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r))}, Con{J.FArr{acc}, up}, J.MCommaOrClose{}}),
    J.loop(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r)))), J.Run{S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r)), Con{J.FArr{acc}, up}, J.MValue{}}),
    J.loop(A.add(w2, A.len(r)), J.emit(J.JArr{PA.rlj(acc, Con{h, t})}, r, up)),
    PA.step(slack, SCon{',', S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r))}, A.len(S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r))), Con{J.FArr{acc}, up}, J.MCommaOrClose{}, {==}),
    Equal.trans(J.St,
      J.loop(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r)))), J.Run{S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r)), Con{J.FArr{acc}, up}, J.MValue{}}),
      J.loop(A.add(w1, A.len(S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r))), J.Run{S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r), Con{J.FArr{Con{h, acc}}, up}, J.MCommaOrClose{}}),
      J.loop(A.add(w2, A.len(r)), J.emit(J.JArr{PA.rlj(acc, Con{h, t})}, r, up)),
      p1,
      p2)))

law arr_t.2:
  for +h: J.Json
  for +t: List<&2, J.Json>
  for +acc: List<&2, J.Json>
  for +up: List<&2, J.Frame>
  for +r: String
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +w1: Nat
  for p1: {J.loop(A.add(slack, A.len(S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r)))), J.Run{S.bw(p, S.wstr(cs), 1n+d) ++ S.lay(h, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r)), Con{J.FArr{acc}, up}, J.MValue{}}) == J.loop(A.add(w1, A.len(S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r))), PA.result(False{}, h, Con{J.FArr{acc}, up}, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r))) : J.St}
  for g2: Goal("", J.JArr{t}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{Con{h, acc}}, up}, r, w1)
  Goal("", J.JArr{Con{h, t}}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{acc}, up}, r, slack)

def arr_t.2(h, t, acc, up, r, slack, p, cs, d, w1, p1, g2):
  (+w2, p2) = g2
  arr_t.3(h, t, acc, up, r, slack, p, cs, d, w1, p1, w2, p2)

law arr_t.1:
  for +h: J.Json
  for +t: List<&2, J.Json>
  for +acc: List<&2, J.Json>
  for +up: List<&2, J.Frame>
  for +r: String
  for +slack: Nat
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for g1: Goal(S.bw(p, S.wstr(cs), 1n+d), h, False{}, p, cs, 1n+d, J.MValue{}, Con{J.FArr{acc}, up}, S.lay(J.JArr{t}, True{}, p, S.wstr(cs), d, r), slack)
  for ih2: @w: Nat -> Goal("", J.JArr{t}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{Con{h, acc}}, up}, r, w)
  Goal("", J.JArr{Con{h, t}}, True{}, p, cs, d, J.MCommaOrClose{}, Con{J.FArr{acc}, up}, r, slack)

def arr_t.1(h, t, acc, up, r, slack, p, cs, d, g1, ih2):
  (+w1, p1) = g1
  arr_t.2(h, t, acc, up, r, slack, p, cs, d, w1, p1, ih2(w1))

law obj_f.4:
  for +k: String
  for +v: J.Json
  for +t: List<&2, J.Field>
  for +stk: List<&2, J.Frame>
  for +r: String
