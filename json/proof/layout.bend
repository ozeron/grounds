  for vm: PA.ValMode(m)
  for +p: Bool
  for +cs: List<&2, S.WsC>
  for +d: Nat
  for +x: Nat
  for ex: {A.len(S.esc(k, SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}})) == A.add(x, A.len(SCon{'"', SCon{':', S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))}})) : Nat}
  for +w1: Nat
  for p1: {J.loop(A.add(A.add(A.add(A.add(A.add(slack, A.len(pre)), A.len(S.bw(p, S.wstr(cs), 1n+d))), x), 1n), A.len(S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)))), J.Run{S.sp(p) ++ S.lay(v, False{}, p, S.wstr(cs), 1n+d, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r)), Con{J.FObj{[], k}, stk}, J.MValue{}}) == J.loop(A.add(w1, A.len(S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))), PA.result(False{}, v, Con{J.FObj{[], k}, stk}, S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))) : J.St}
  for +w2: Nat
  for p2: {J.loop(A.add(w1, A.len(S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r))), J.Run{S.lay(J.JObj{t}, True{}, p, S.wstr(cs), d, r), Con{J.FObj{[J.Field{k, v}], ""}, stk}, J.MCommaOrClose{}}) == J.loop(A.add(w2, A.len(r)), PA.result(True{}, J.JObj{t}, Con{J.FObj{[J.Field{k, v}], ""}, stk}, r)) : J.St}
  Goal(pre, J.JObj{Con{J.Field{k, v}, t}}, False{}, p, cs, d, m, stk, r, slack)

